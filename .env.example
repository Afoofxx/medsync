# ============================================================
# MedSync — environment variables
# Only Supabase is required. No paid services.
# ============================================================

# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Default map center (Lagos)
VITE_MAP_DEFAULT_LAT=6.5244
VITE_MAP_DEFAULT_LNG=3.3792
VITE_MAP_DEFAULT_ZOOM=11
